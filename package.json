{
  "name": "ts-prune",
  "version": "0.10.4",
  "description": "Find potentially unused exports in your Typescript project with zero configuration.",
  "keywords": [
    "find",
    "unused",
    "exports",
    "deadcode"
  ],
  "main": "lib/index.js",
  "author": "Kasparov Nikolai",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublish": "rm -rf lib && pnpm build",
    "pretest": "pnpm lint",
    "test": "jest --coverage",
    "test:integration": "sh integration/test.sh",
    "lint": "eslint . --cache --fix --ext .ts,.tsx",
    "format": "prettier . --write",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/json5": "^0.0.30",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "semantic-release": "21.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.5.3"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "commander": "8.3.0",
    "cosmiconfig": "8.1.3",
    "json5": "2.2.3",
    "lodash": "4.17.21",
    "true-myth": "4.1.1",
    "ts-morph": "^21.0.1"
  },
  "files": [
    "/lib"
  ],
  "bin": "./lib/index.js",
  "repository": "git@github.com:nadeesha/ts-prune.git",
  "types": "lib/index.d.ts"
}
